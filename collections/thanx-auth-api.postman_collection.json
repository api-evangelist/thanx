{
  "item": [
    {
      "id": "6adaff53-356d-439e-bbf9-e730032b5cef",
      "name": "Auth",
      "description": {
        "content": "Acquire privileged end-user access tokens.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "9f74b831-8b26-409f-b1d8-c3140108ed08",
          "name": "Create Access Token",
          "request": {
            "name": "Create Access Token",
            "description": {
              "content": "Acquires a privileged end-user access token for a given merchant and identifier (user, email, or phone).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "partner",
                "oauth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchant_id\": \"<string>\",\n  \"user_id\": \"<string>\",\n  \"email\": \"<email>\",\n  \"phone\": \"<string>\",\n  \"expires_in\": \"<integer>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "85a64467-af7b-49be-bbb4-5c0680541bf1",
              "name": "The issued access token.",
              "originalRequest": {
                "url": {
                  "path": [
                    "partner",
                    "oauth",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"merchant_id\": \"92b7b0dac4\",\n  \"user_id\": \"92b7b0dac4\",\n  \"email\": \"jane.smith@example.com\",\n  \"phone\": \"+14158672345\",\n  \"expires_in\": 1\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"945148251b603ae34561d90acfe4050e\",\n  \"token_type\": \"945148251b603ae34561d90acfe4050e\",\n  \"scope\": \"passwordless\",\n  \"created_at\": 1577836800,\n  \"expires_in\": 1\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
  "event": [],
  "variable": [
    {
      "type": "string",
      "value": "https://api.thanx.com",
      "key": "baseUrl"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}"
      }
    ]
  },
  "info": {
    "_postman_id": "c941a853-1eec-4c6c-b5e0-0630d73f4efb",
    "name": "Thanx Consumer Account Auth API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Thanx Consumer API lets brands integrate Thanx into a custom consumer experience, covering users and authentication, cards, gift cards, rewards, purchases, points and loyalty balances, locations, and feedback. It powers branded apps and digital experiences built on top of the Thanx loyalty and CRM platform. Endpoints are protected and authorized via end-user access tokens acquired through Thanx SSO.\n\nContact Support:\n Name: Kin Lane\n Email: kin@apievangelist.com",
      "type": "text/plain"
    }
  }
}