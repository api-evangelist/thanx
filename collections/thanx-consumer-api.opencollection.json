        },
        {
          "info": {
            "name": "Delete Card",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.thanx.com/cards/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Archives a registered card."
        }
      ]
