{
  "opencollection": "1.0.0",
  "info": {
    "name": "Thanx Consumer Account Gift Cards API",
    "version": "v4.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Gift Cards",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Gift Cards",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.thanx.com/gift_cards"
          },
          "docs": "Retrieves the authenticated user's gift cards."
        },
        {
          "info": {
            "name": "Create Gift Card",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.thanx.com/gift_cards",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new digital gift card."
        }
      ]
    }
  ],
  "bundled": true
}